# Environment variables for training-coach-mcp.
# Copy to .env (never commit it) and fill in your values.

# Path to the TOML configuration file (alternative: pass it as CLI argument).
TRAINING_MCP_CONFIG=/app/config/config.toml

# WebDAV credentials for the Nextcloud source. The TOML config references
# these variable *names*; the actual values live only here.
NEXTCLOUD_USERNAME=example-user
NEXTCLOUD_APP_PASSWORD=example-app-password

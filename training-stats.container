# Quadlet unit (rootless podman). The <repo-root> placeholders are replaced
# with the absolute repository path at install time; see README.md
# ("Podman deployment (Quadlet)").

[Unit]
Description=Training Stats REST API server

[Container]
# Published by CI on every push to main. If the package is kept private,
# run "podman login ghcr.io" once as the service user first.
Image=ghcr.io/lackhove/training-stats:latest
ContainerName=training-stats
Network=training-stats.network
EnvironmentFile=<repo-root>/.env
Volume=<repo-root>/config.toml:/app/config/config.toml:ro
Volume=<repo-root>/data:/app/data
Volume=/path/to/activities:/data/activities:ro
# No PublishPort: the API is reachable only from containers on the shared
# training-stats network. For same-host-only access from outside containers,
# add PublishPort=127.0.0.1:<port>:<port>.

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
